###################################################################################################
#### Install Google Chrome for Selenium on Amazon Linux 2023
#### This runs during deployment BEFORE the application starts
###################################################################################################

commands:
  01_install_chrome:
    command: |
      set -e
      echo "===== Starting Chrome Installation ====="
      
      # Check if Chrome is already installed
      if command -v google-chrome &> /dev/null; then
        INSTALLED_VERSION=$(google-chrome --version)
        echo "Chrome already installed: $INSTALLED_VERSION"
        exit 0
      fi
      
      # Download Chrome RPM
      echo "Downloading Chrome RPM..."
      cd /tmp
      wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm
      
      # Install Chrome using dnf (Amazon Linux 2023 uses dnf, not yum)
      echo "Installing Chrome..."
      dnf install -y /tmp/google-chrome-stable_current_x86_64.rpm
      
      # Install Chrome dependencies
      echo "Installing Chrome dependencies..."
      dnf install -y \
        liberation-fonts \
        libX11 \
        libXcomposite \
        libXdamage \
        libXext \
        libXrandr \
        libgbm \
        libxkbcommon \
        nss \
        atk \
        at-spi2-atk \
        cups-libs \
        alsa-lib
      
      # Cleanup
      rm -f /tmp/google-chrome-stable_current_x86_64.rpm
      
      # Verify installation
      echo "Verifying Chrome installation..."
      if command -v google-chrome &> /dev/null; then
        CHROME_VERSION=$(google-chrome --version)
        echo "SUCCESS: Chrome installed - $CHROME_VERSION"
        which google-chrome
        ls -la /usr/bin/google-chrome
      else
        echo "ERROR: Chrome installation failed!"
        exit 1
      fi
      
      echo "===== Chrome Installation Complete ====="
    ignoreErrors: false
    test: "! command -v google-chrome"

  02_verify_chrome_permissions:
    command: |
      # Ensure Chrome has correct permissions
      if [ -f /usr/bin/google-chrome ]; then
        chmod +x /usr/bin/google-chrome
        echo "Chrome permissions verified"
      fi
    ignoreErrors: true
